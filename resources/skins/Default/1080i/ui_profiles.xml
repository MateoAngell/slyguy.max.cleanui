<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="13002">
    <backgroundcolor>FF080B0E</backgroundcolor>
    <controls>
        <!-- Dialog backgroundcolor does not cover the parent Kodi window. -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>stretch</aspectratio>
            <texture colordiffuse="FF080B0E">white.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <aspectratio>keep</aspectratio>
            <texture>gradient-vertical.png</texture>
        </control>
        <control type="label">
            <left>200</left>
            <top>180</top>
            <width>1520</width>
            <height>65</height>
            <font>font48</font>
            <label>¿Quién está viendo?</label>
            <textcolor>FFFFFFFF</textcolor>
            <aligny>center</aligny>
            <scroll>false</scroll>
            <align>center</align>
        </control>
        <control type="list" id="4100">
            <animation effect="fade" start="65" end="100" time="150" condition="String.IsEqual(Window.Property(cleanui.motion),true)">WindowOpen</animation>
            <animation effect="slide" start="0,8" end="0,0" time="150" tween="cubic" easing="out" condition="String.IsEqual(Window.Property(cleanui.motion),true)">WindowOpen</animation>
            <left>260</left>
            <top>380</top>
            <width>1400</width>
            <height>330</height>
            <orientation>horizontal</orientation>
            <scrolltime>150</scrolltime>
            <onup>4100</onup>
            <ondown>1003</ondown>
            <onleft>4100</onleft>
            <onright>4100</onright>
            <itemlayout width="280" height="330">
                <control type="image">
                    <left>30</left>
                    <top>16</top>
                    <width>220</width>
                    <height>220</height>
                    <aspectratio>keep</aspectratio>
                    <texture diffuse="circle-hd.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>10</left>
                    <top>250</top>
                    <width>260</width>
                    <height>50</height>
                    <font>font28</font>
                    <label>$INFO[ListItem.Label]</label>
                    <textcolor>FFFFFFFF</textcolor>
                    <aligny>center</aligny>
                    <scroll>false</scroll>
                    <align>center</align>
                </control>
            </itemlayout>
            <focusedlayout width="280" height="330">
                <control type="image">
                    <left>30</left>
                    <top>16</top>
                    <width>220</width>
                    <height>220</height>
                    <aspectratio>keep</aspectratio>
                    <texture diffuse="circle-hd.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="image">
                    <left>18</left>
                    <top>4</top>
                    <width>244</width>
                    <height>244</height>
                    <aspectratio>keep</aspectratio>
                    <texture>profile-ring-hd.png</texture>
                    <visible>Control.HasFocus(4100)</visible>
                </control>
                <control type="label">
                    <left>10</left>
                    <top>250</top>
                    <width>260</width>
                    <height>50</height>
                    <font>font28</font>
                    <label>$INFO[ListItem.Label]</label>
                    <textcolor>FFFFFFFF</textcolor>
                    <aligny>center</aligny>
                    <scroll>false</scroll>
                    <align>center</align>
                </control>
            </focusedlayout>
        </control>
        <control type="button" id="1003">
            <left>820</left>
            <top>780</top>
            <width>280</width>
            <height>64</height>
            <font>font24</font>
            <label>Volver</label>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FFDDDDDD</textcolor>
            <focusedcolor>FF101010</focusedcolor>
            <texturefocus colordiffuse="FFFFFFFF">rounded-rect.png</texturefocus>
            <texturenofocus colordiffuse="FF303030">rounded-rect.png</texturenofocus>
            <onup>4100</onup>
            <onleft>1003</onleft>
            <onright>1003</onright>
        </control>
    </controls>
</window>
